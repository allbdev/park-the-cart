{
  "name": "park-the-cart",
  "private": true,
  "version": "0.1.0",
  "description": "Park the Cart (Estacione o Carrinho): push a shopping cart with one bad wheel into the corral without scratching the cars.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4183 --strictPort",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run size",
    "size": "tsx tools/size-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/cutive-mono": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "fast-check": "^4.10.3",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
